# Postgres connection string (Neon)
# Pooled connection, used by the running app.
# Supabase: use the pooler in TRANSACTION mode (port 6543) and keep ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Direct (non-pooled) connection, used ONLY by `prisma migrate`.
# Supabase: Project Settings -> Database -> Connection string -> "Direct connection".
# Migrations hold a session and take advisory locks, which a pooler breaks — via
# the session-mode pooler they fail with "EMAXCONNSESSION: max clients reached".
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Prognosis API
PROGNOSIS_BASE="https://prognosis-api.leadwayhealth.com"

# Dedicated Prognosis service account for this app. Used two ways:
# 1. HTTP Basic auth on staff sign-in (ExternalPortalLogin) — identifies this
#    app/portal to Prognosis; the actual staff member's own credentials go
#    in the request body, not here.
# 2. Username/password login (ApiUsers/Login) to get a Bearer token for
#    sending member notification emails/SMS.
PROGNOSIS_SERVICE_USERNAME=""
PROGNOSIS_SERVICE_PASSWORD=""

# Comma-separated Prognosis usernames that are auto-granted Admin role on first login
ADMIN_USERNAMES="f-komoni-mbaekwe"
